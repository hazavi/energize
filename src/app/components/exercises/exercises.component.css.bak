/* ══════════════════════════════════════════════════════════ */
/*  Exercises Page – Dark Glassmorphic                       */
/* ══════════════════════════════════════════════════════════ */
:host {
  --accent: #6366f1;
  --accent-hover: #818cf8;
  --glass-bg: rgba(255,255,255,0.03);
  --glass-border: rgba(255,255,255,0.06);
  --surface: rgba(255,255,255,0.04);
  --muted: #71717a;
  --muted-fg: #a1a1aa;
  --text: #f4f4f5;
  --radius: 10px;
  display: block;
}

/* ── Main Container ── */
.exercises-container {
  padding: 0;
  max-width: 1280px;
  min-height: 80vh;
  margin: 0 auto;
}

/* ── Title ── */
.title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 1.25rem;
  display: flex;
  align-items: center;
  gap: 10px;
  letter-spacing: -0.025em;
}

.title::before {
  font-weight: 900;
  color: var(--text);
}

/* ── Exercise Grid ── */
.exercises-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
  margin-bottom: 2rem;
}

/* ── Exercise Card ── */
.exercise-card {
  display: flex;
  flex-direction: column;
  background: var(--glass-bg);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  border: 1px solid var(--glass-border);
  height: 100%;
}

.exercise-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  border-color: rgba(99,102,241,0.25);
  cursor: pointer;
}

/* ── Thumbnail ── */
.thumbnail {
  position: relative;
  padding-top: 65%;
  background: var(--surface);
  overflow: hidden;
}

.exercise-thumbnail {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background-color: #fff;
  transition: transform 300ms ease;
}

.exercise-card:hover .exercise-thumbnail {
  transform: scale(1.04);
}

.no-image-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
}

.no-image-overlay i {
  font-size: 2rem;
  color: var(--muted);
}

/* ── Exercise Details ── */
.details {
  padding: 12px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.exercise-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text);
  margin: 0 0 8px 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.exercise-name::before {
  font-weight: 900;
  position: absolute;
  left: 0;
  top: 0;
  color: var(--text);
  font-size: 0.9rem;
}

.details p {
  display: flex;
  align-items: center;
  font-size: 0.78rem;
  margin-bottom: 0.4rem;
  color: var(--muted-fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 400;
}

.details strong {
  color: var(--text);
  margin-right: 0.4rem;
  font-size: 0.8rem;
}

/* ── Meta Info ── */
.meta-info {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  margin-top: auto;
  border-top: 1px solid var(--glass-border);
  padding-top: 8px;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 4px;
  max-width: 48%;
}

.bodypart-icon,
.category-icon {
  color: var(--muted-fg);
  font-size: 0.8rem;
  width: 14px;
  text-align: center;
  flex-shrink: 0;
}

.meta-value {
  color: var(--muted-fg);
  font-size: 0.78rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Loading ── */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 2rem 0;
}

/* ── Empty State ── */
.no-exercises {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 0;
  color: var(--text);
  text-align: center;
}

.no-exercises p {
  margin-bottom: 16px;
  font-size: 1rem;
  color: var(--muted-fg);
}

/* ── Pagination ── */
.pagination-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 2rem;
  gap: 6px;
}

.pagination-btn {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--glass-border);
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 150ms ease;
}

.pagination-btn:hover:not([disabled]) {
  background: rgba(255,255,255,0.08);
  border-color: rgba(99,102,241,0.3);
}

.pagination-btn[disabled] {
  background: rgba(255,255,255,0.02);
  color: var(--muted);
  cursor: not-allowed;
  border-color: var(--glass-border);
}

.pagination-btn i {
  font-size: 13px;
}

.pagination-numbers {
  display: flex;
  gap: 4px;
}

.page-number {
  background: var(--surface);
  color: var(--muted-fg);
  border: 1px solid var(--glass-border);
  min-width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 150ms ease;
  font-size: 0.835rem;
  font-weight: 500;
}

.page-number:hover {
  background: rgba(255,255,255,0.08);
  color: var(--text);
}

.page-number.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  font-weight: 600;
}

.ellipsis {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  height: 36px;
  color: var(--muted);
  font-size: 13px;
}

/* ── Search & Filter Container ── */
.search-filter-container {
  border-radius: var(--radius);
  padding: 14px;
  margin-bottom: 20px;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
}

.search-bar {
  position: relative;
  flex: 1;
  min-width: 200px;
  margin-bottom: 0;
}

.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  font-size: 15px;
}

.search-input {
  width: 100%;
  padding: 10px 12px 10px 38px;
  background: var(--surface);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  color: var(--text);
  font-size: 0.835rem;
  box-sizing: border-box;
  transition: border-color 150ms, box-shadow 150ms;
  font-family: inherit;
}

.search-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
}

.search-input::placeholder {
  color: #52525b;
}

/* ── Filter Options ── */
.filter-options {
  display: flex;
  flex-wrap: nowrap;
  gap: 10px;
  align-items: center;
}

.filter-select {
  width: 170px;
  min-width: unset;
  flex: 0 0 auto;
}

.filter-select label {
  display: inline-block;
  margin-right: 6px;
  margin-bottom: 0;
  color: var(--muted-fg);
  font-size: 0.78rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.filter-select select {
  width: 100%;
  padding: 9px 12px;
  background: var(--surface);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  color: var(--text);
  font-size: 0.835rem;
  appearance: none;
  cursor: pointer;
  font-family: inherit;
  background-image: url("data:image/svg+xml;utf8,<svg fill='%23a1a1aa' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
  background-repeat: no-repeat;
  background-position: right 8px top 50%;
  transition: border-color 150ms, box-shadow 150ms;
}

.filter-select select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
}

.clear-filters-btn {
  background: var(--surface);
  color: var(--muted-fg);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  padding: 9px 14px;
  font-size: 0.835rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 150ms ease;
  height: 36px;
  font-family: inherit;
}

.clear-filters-btn:hover:not([disabled]) {
  background: rgba(255,255,255,0.08);
  color: var(--text);
}

.clear-filters-btn[disabled] {
  opacity: 0.4;
  cursor: not-allowed;
}

.clear-filters-btn i {
  font-size: 11px;
}

/* ── Responsive Filters ── */
@media (max-width: 992px) {
  .search-filter-container {
    flex-direction: column;
    align-items: stretch;
  }

  .search-bar {
    margin-bottom: 0;
    width: 100%;
  }

  .filter-options {
    width: 100%;
  }
}

@media (max-width: 768px) {
  .filter-options {
    flex-wrap: wrap;
  }

  .filter-select {
    width: calc(50% - 5px);
    flex: 0 0 auto;
  }

  .clear-filters-btn {
    width: 100%;
    justify-content: center;
  }
}

/* ── Responsive Grid ── */
@media (max-width: 1200px) {
  .exercises-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 900px) {
  .exercises-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .exercises-grid { grid-template-columns: 1fr; }
  .title { font-size: 1.25rem; }
}


/* ══════════════════════════════════════════════════════════ */
/*  GymVisual Exercise Catalog                               */
/* ══════════════════════════════════════════════════════════ */
.gymvisual-section {
  margin-top: 0;
  padding-top: 0;
}

.gymvisual-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.gymvisual-title {
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  letter-spacing: -0.025em;
}

.gymvisual-title i {
  color: var(--accent);
  font-size: 1.2rem;
}

.gymvisual-count {
  font-size: 0.8rem;
  color: var(--muted-fg);
  background: var(--surface);
  padding: 5px 12px;
  border-radius: 20px;
  border: 1px solid var(--glass-border);
  font-weight: 500;
}

/* ── GymVisual Filter Bar ── */
.gymvisual-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 1rem;
  padding: 14px;
  background: var(--glass-bg);
  border-radius: var(--radius);
  border: 1px solid var(--glass-border);
}

.gv-filter-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1;
  min-width: 160px;
}

.gv-filter-label {
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.gv-select {
  width: 100%;
  padding: 9px 12px;
  background: var(--surface);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  color: var(--text);
  font-size: 0.835rem;
  appearance: none;
  cursor: pointer;
  font-family: inherit;
  background-image: url("data:image/svg+xml;utf8,<svg fill='%23a1a1aa' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
  background-repeat: no-repeat;
  background-position: right 8px top 50%;
  transition: border-color 150ms, box-shadow 150ms;
}

.gv-select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(99,102,241,0.2);
}

.gv-select option,
.filter-select select option {
  background: #18181b;
  color: #f4f4f5;
}


/* ── GymVisual Grid ── */
.gymvisual-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
  margin-bottom: 2rem;
}

/* ── GymVisual Card ── */
.gv-card {
  display: flex;
  flex-direction: column;
  background: var(--glass-bg);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  border: 1px solid var(--glass-border);
  cursor: pointer;
}

.gv-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  border-color: rgba(99,102,241,0.25);
}

.gv-thumbnail {
  position: relative;
  padding-top: 115%;
  background-color: #fff;
  overflow: hidden;
}

.gv-frozen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  z-index: 2;
  transition: opacity 200ms ease;
}

.gv-gif {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0;
  z-index: 1;
  transition: opacity 200ms ease, transform 300ms ease;
}

.gv-card:hover .gv-frozen {
  opacity: 0;
}

.gv-card:hover .gv-gif {
  opacity: 1;
  transform: scale(1.04);
}

.gv-details {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.gv-name {
  font-size: 0.835rem;
  font-weight: 600;
  color: var(--text);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

/* ── Tag Badges ── */
.gv-tags {
  display: flex;
  flex-wrap: nowrap;
  gap: 4px;
  margin-top: 8px;
  overflow: hidden;
}

.gv-tag {
  font-size: 0.6rem;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: 4px;
  white-space: nowrap;
  letter-spacing: 0.02em;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.06);
  color: #a1a1aa;
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: background 150ms ease, color 150ms ease;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

.gv-tag:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #e4e4e7;
}

.gv-ref {
  font-size: 0.7rem;
  color: var(--muted);
  font-family: 'Courier New', monospace;
}

.gymvisual-product-count {
  text-align: center;
  color: var(--muted-fg);
  font-size: 0.8rem;
  margin-top: 0.75rem;
  padding: 6px 0;
}

/* ── Responsive GymVisual ── */
@media (max-width: 992px) {
  .gymvisual-filters { flex-direction: column; }
  .gv-filter-group { min-width: 100%; }
}

@media (max-width: 768px) {
  .gymvisual-grid { grid-template-columns: repeat(2, 1fr); }
  .gymvisual-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
}

@media (max-width: 480px) {
  .gymvisual-grid { grid-template-columns: 1fr; }
}
